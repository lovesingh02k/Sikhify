# Sikhify — environment variables (copy to .env; never commit .env)
# Every variable is optional for local development.

# --- API server -------------------------------------------------------------
# NODE_ENV=production            # production: secure cookies, serves dist/, binds 0.0.0.0
# PORT=8787
# HOST=127.0.0.1

# Local SQLite database file (development fallback).
# SIKHIFY_DB_PATH=server/data/sikhify.db
# Production / Vercel: remote libSQL/Turso database.
# SIKHIFY_DATABASE_URL=libsql://your-db.turso.io
# SIKHIFY_DATABASE_AUTH_TOKEN=your-turso-auth-token
# Uploaded images. On Vercel/Turso image bytes are stored in the uploads table so they survive function replacement.
# SIKHIFY_UPLOAD_DIR=server/uploads

# Public origin of the site, used in password-reset links.
# Required in production when not using Vercel's VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL.
# SIKHIFY_PUBLIC_URL=http://localhost:5173

# Cookies are Secure (HTTPS-only) in production by default.
# SIKHIFY_COOKIE_SECURE=true
# Set to true behind a reverse proxy/load balancer so rate limits use the real client IP.
# SIKHIFY_TRUST_PROXY=false
# SIKHIFY_SESSION_DAYS=30
# Serve the built site from dist/ (default: true in production).
# SIKHIFY_SERVE_STATIC=true

# --- Email (password resets) ------------------------------------------------
# Without these, development prints reset links to the server console and
# production logs a warning (admins can issue reset links from /admin/users).
# RESEND_API_KEY=
# MAIL_FROM=Sikhify <no-reply@your-domain>

# --- Admin bootstrap (optional) ---------------------------------------------
# Lets `npm run admin:create` run without an interactive password prompt.
# SIKHIFY_ADMIN_PASSWORD=

# --- Vite dev/preview -------------------------------------------------------
# Where the dev server forwards /api and /uploads.
# SIKHIFY_API_PROXY=http://127.0.0.1:8787

# --- Gurdwara Directory maps (read at build time) ---------------------------
# "leaflet" (default, no API key needed) or "none" to hide interactive maps;
# "Open in Maps" / "Get Directions" links work either way.
# VITE_MAP_PROVIDER=leaflet
# Tile template. OpenStreetMap's public tiles suit modest traffic only (see
# their tile usage policy); for heavy use point this at a hosted tile service.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
