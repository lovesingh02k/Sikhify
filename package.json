{
  "name": "sikhify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "build:frontend": "npm run build -w frontend",
    "preview": "node scripts/dev.js --preview",
    "start": "npm start -w backend",
    "test": "npm run test:shared && npm run test:frontend && npm run test:backend",
    "test:shared": "node --test \"tests/*.test.js\"",
    "test:frontend": "npm test -w frontend",
    "test:backend": "npm test -w backend",
    "admin:create": "node backend/scripts/create-admin.js",
    "gurdwaras:fetch-wikidata": "node backend/scripts/fetch-wikidata-gurdwaras.js",
    "gurdwaras:import": "node backend/scripts/import-gurdwaras.js",
    "gurdwaras:import-historic": "node backend/scripts/import-gurdwaras.js backend/seed/gurdwaras/india-historic-gurdwaras.json",
    "gurdwaras:dev-fixtures": "node backend/scripts/seed-dev-gurdwaras.js",
    "gurdwaras:audit-verification": "node backend/scripts/audit-gurdwara-verification.js",
    "directory:import": "node backend/scripts/import-directory.js",
    "directory:diagnose": "node backend/scripts/diagnose-directory.js",
    "observances:import": "node backend/scripts/import-observances.js",
    "uploads:optimize": "node backend/scripts/optimize-uploads.js",
    "uploads:cleanup": "node backend/scripts/cleanup-uploads.js"
  },
  "engines": {
    "node": ">=22.13"
  }
}
